$('document').ready(function () {

    //Decimal only for cal responses
    $(".decimalInput").on("keypress keyup blur", function (event) {
        var LanguageId = $('#languageId').val();
        if (LanguageId == 2) {
            $(this).val($(this).val().replace(/[^0-9\.,]/g, ''));
            if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57) && event.which != 8 && (event.which != 44 || $(this).val().indexOf(',') != -1)) {
                event.preventDefault();
            }
        } else {
            if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57) && event.which != 8) {
                event.preventDefault();
            }
        }
    });
});
function GenerateItemsHTML(assessmentItemTypes, isSummary, isPreview) {
   
    var itemTypeDiv = '<div class="question-type-##index##">\
                <p class="question-popup-title">##ItemType##</p>\
                <div class="questions-list" id="div##ItemType##Items" style="background-color: ##BackColor##;color:##Color##">\
                    ##ItemsHtml##\
                </div></div>';

    var divclassName = (isPreview == "True") ? "preview-item " : "leftpanel-item ";

    var itemBoxHtml = '<div class="pull-left display-inline question-list not-visited "' + divclassName + '"">\
                   <a href="javascript:(void)" class="questionNo" data-value="question1" quest-id="#itemId#">';

    if (isPreview === "True") {
        itemBoxHtml += "<span class='question-no bg-not-answered'>"
    }
    else {
        itemBoxHtml += "<span class='question-no bg-not-answered' title='Not Answered'>"
    }

    itemBoxHtml += "#itemOrder# </span></a></div>";

    var index = 1;
    var totalItemsCount = 0;
    var totalAnsweredItems = 0;
    var totalMarkedForReviewItems = 0;

    //This is assessment items grouped by their types.
    //Build item box htmls for dashboard
    for (var key in assessmentItemTypes) {

        //get items related to type (i.e. from group)
        var assessmentItems = assessmentItemTypes[key];
        
        var itemBoxHtmlWithClassNames = '';

        var itemTypeTotalCount = assessmentItems.length;

        var answeredItemTypeCount = 0, itemTypeMarkedForReviewCount = 0, totalNotAnsweredItems = 0;

        var backgroundColor = textColor = '';

        $.each(assessmentItems, function (idx, assessmentItem) {

            if (idx == 0) {
                backgroundColor = assessmentItem.BackgroundColor;
                textColor = assessmentItem.TextColor;
            }
            
            itemBoxHtmlWithClassNames += itemBoxHtml.replace("#itemOrder#", assessmentItem.Order).replace("#itemId#", assessmentItem.ItemId);

            if (assessmentItem.IsAnswered)
                answeredItemTypeCount++;

            if (assessmentItem.MarkedForReview)
                itemTypeMarkedForReviewCount++;
        });

        //This is for Quesion page items dashboard
       // if (!isSummary) {
            var itemTypeDivHtml = itemTypeDiv.replace("##index##", index).replace("##ItemType##", key).replace("##ItemType##", key).replace("##ItemsHtml##", itemBoxHtmlWithClassNames);            
            $(".assessmentItemsDiv").append(itemTypeDivHtml);
        //} else {
            //This is for Summary page items dashboard
            var row = $('<tr></tr>');

            var span = $("<span />").addClass("qsn-type section-size").css({
                "background-color": backgroundColor,
                "color": textColor
            }).html(key);

            var itemTypeTd = $('<td></td>').addClass("hidden-xs td-padding").append(span);
            var itemBoxesTd = $('<td></td>').addClass("text-center hidden-xs td-padding").append(itemBoxHtmlWithClassNames);
            var answeredItemsTd = $('<td></td>').addClass("text-center hidden-xs td-padding table-answered").append(answeredItemTypeCount);
            var notAnsweredItemsTd = $('<td></td>').addClass("text-center hidden-xs td-padding table-notanswered").append(itemTypeTotalCount - answeredItemTypeCount);
            var markReviewedItemsTd = $('<td></td>').addClass("text-center hidden-xs td-padding table-markreview").append(itemTypeMarkedForReviewCount);
            row.append(itemTypeTd).append(itemBoxesTd).append(answeredItemsTd).append(notAnsweredItemsTd).append(markReviewedItemsTd);

            $(".tbody-summary").append(row);
     //   }

        totalItemsCount += itemTypeTotalCount;
        totalAnsweredItems += answeredItemTypeCount;
        totalMarkedForReviewItems += itemTypeMarkedForReviewCount;
        index++;
    }

    totalNotAnsweredItems = totalItemsCount - totalAnsweredItems;

   // if (isSummary) {

        var finalrow = $('<tr></tr>');
        var totalItemTd = $('<td></td>').addClass("hidden-xs td-padding text-center total-sections").html("<strong>Total</strong>");

        var span = $("<span />").addClass("total-questions-num").html(totalItemsCount);
        var strong = $("<strong />").append("<span>NO. of Questions  =  </span>").append(span);
        var totalNoOfItemsTd = $('<td></td>').addClass("text-left hidden-xs td-padding").append(strong);

        var answeredSpan = $("<span />").addClass("question-no answer-count").attr("title", "Answered").text(totalAnsweredItems);
        var answeredAnchor = $("<a/>").addClass("questionNo").append(answeredSpan);
        var answeredDiv = $("<div/>").addClass("display-inline question-list answered").append(answeredAnchor);
        var totalAnsweredTd = $('<td></td>').addClass("text-center hidden-xs td-padding table-answered").append(answeredDiv);

        var notAnsweredSpan = $("<span />").addClass("question-no notanswer-count").attr("title", "Not Answered").text(totalNotAnsweredItems);
        var notAnsweredAnchor = $("<a/>").addClass("questionNo").append(notAnsweredSpan);
        var notAnsweredDiv = $("<div/>").addClass("display-inline question-list not-answered").append(notAnsweredAnchor);
        var totalNotAnsweredTd = $('<td></td>').addClass("text-center hidden-xs td-padding table-notanswered").append(notAnsweredDiv);

        var markReviewedSpan = $("<span />").addClass("question-no markreview-count").attr("title", "Mark for Review").text(totalMarkedForReviewItems);
        var markReviewedAnchor = $("<a/>").addClass("questionNo").append(markReviewedSpan);
        var markReviewedDiv = $("<div/>").addClass("display-inline question-list mark-review").append("<div class='mark-triangle'></div>").append(markReviewedAnchor);
        var totalmarkReviewedTd = $('<td></td>').addClass("text-center hidden-xs td-padding table-markreview").append(markReviewedDiv);

        finalrow.append(totalItemTd).append(totalNoOfItemsTd).append(totalAnsweredTd).append(totalNotAnsweredTd).append(totalmarkReviewedTd);

        $(".tbody-summary").append(finalrow);
    //} else {
        $(".ds-answer-count").html("<b>" + totalAnsweredItems + "/" + totalItemsCount + "</b>")
        $(".ds-notanswer-count").html("<b>" + totalNotAnsweredItems + "/" + totalItemsCount + "</b>")
        $(".ds-markreview-count").html("<b>" + totalMarkedForReviewItems + "/" + totalItemsCount + "</b>")
  //  }
}

function SetItemCssClasses(assessmentItemTypes, isSummary, isPreview) {

    for (var key in assessmentItemTypes) {

        var assessmentItems = assessmentItemTypes[key];

        $.each(assessmentItems, function (index, assessmentItem) {

            var itemsfound = $("a[quest-id='" + assessmentItem.ItemId + "']");
            var itemHoverTitle = "Not Answered";
            var lhsCssClass = "";

            $.each(itemsfound, function (index, item) {

                $(item).removeClass();
                $(item).parent().removeClass();
                $(item).children().first().removeClass();

                var divclassName = "pull-left display-inline question-list ";
                var anchorclassName = "questionNo ";
                var questionclassName = "question-no ";

                if (isPreview == "True") {
                    divclassName += "preview-item ";
                }
                else {
                    if (isSummary) {
                        divclassName += "summary-item ";
                    } else {
                        divclassName += "leftpanel-item ";
                    }
                }

                if (assessmentItem.IsAnswered) {
                    divclassName += "answered ";
                    itemHoverTitle = "Answered";
                    lhsCssClass = "bg-answered";
                }
                else {
                    divclassName += "not-answered ";
                    itemHoverTitle = "Not Answered";
                    lhsCssClass = "bg-not-answered";
                }

                if (assessmentItem.MarkedForReview) {
                    divclassName += "mark-review";
                    itemHoverTitle = "Marked for Review";
                }

                $(item).addClass(anchorclassName);
                $(item).parent().addClass(divclassName);
                $(item).children().first().addClass(questionclassName);
                $(item).children('span.question-no').attr('title', itemHoverTitle).addClass(lhsCssClass);

                if (assessmentItem.MarkedForReview) {
                    $(item).parent().prepend("<div class='mark-triangle'></div>");
                }
            });
        });
    }
}

function SetActiveItem(currentItemId, isSummary, isPreview) {

    var itemsfound = $("a.questionNo");

    $.each(itemsfound, function (index, item) {
        if ($(item).attr("quest-id") == currentItemId) {
            $(item).addClass("currentActive");
            $(item).parent().addClass("current-question");
            $(item).children().first().addClass("currentActive-Qsn");
            $(item).children('span.question-no').attr('title', 'Current Question');
        }
    });
}


var durationCount = 0;
var storagename = '';

var questionStartDate;
var questionEndDate;

var activityArray = [];

var monitorUserActivity = $("#MonitorUserActivity").val();
var isPractice = $("#IsPractice").val();

var jsonCapturedDataObject = {
    EventId: 0,
    AssessmentId: 0,
    UserId: 0
};

function CaptureNextPreviousButtonClick(questionId, buttonType) {
    if (isPractice == "False" && monitorUserActivity == "True") {
        var eventId = jsonCapturedDataObject.EventId;
        var assessmentId = jsonCapturedDataObject.AssessmentId;
        var userId = jsonCapturedDataObject.UserId;

        var clickDateTime = new Date().toUTCString(); //new Date($.now());
        var clickDateTimeUTC = $("#UTCDateTime").val();

        var clickMessage = `ClickDateTime :- ${clickDateTime} [${clickDateTimeUTC} UTC ]`;

        var durationMessage = `Duration :- ${durationCount} [StartDate:${questionStartDate}--EndDate:${clickDateTime}]`;

        var userActivity = `Question: ${questionId} | User [${userId}-${eventId}-${assessmentId}] | Activity: ButtonClick[${buttonType}] | ${clickMessage} | ${durationMessage}`;

        activityArray.push(userActivity);

        UpdateLocalStorage(storagename);
    }
}

