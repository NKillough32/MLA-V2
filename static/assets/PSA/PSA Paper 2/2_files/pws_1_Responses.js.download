function initializeDurationSelect2(loadDurationUrl) {
    
    var jurisdictionId = $('#JurisdictionId').val();

    $("#duration").select2({
        placeholder: function () {
            $(this).data('placeholder');
        },
        ajax: {
            url: loadDurationUrl,
            dataType: 'json',
            data: {
                JurisdictionId: jurisdictionId
            },

            processResults: function (data) {

                CaptureDropdownSearch('duration', 'duration');

                var duration = data.Results;
                if (duration != null && duration.length > 0) {
                    return {
                        results: $.map(duration, function (item) {
                            return {
                                text: item.Name,
                                id: item.Id
                            };
                        })
                    };
                } else {
                    return {
                        results: []
                    };
                }
            },
            cache: false
        },
        escapeMarkup: function (markup) {
            return markup;
        }, // let our custom formatter work

        selectOnClose: true,
        templateSelection: formatRepoSelection
    });

    $('#duration').on('select2:select', function (e) {
        console.log(3333);
        var data = e.params.data;
        var selectedText = `${data.text} -- ${data.id}`;
        CaptureDropdownSelectedText('duration', selectedText);
    });
}

function formatRepoSelection(repo) {
    return repo.full_name || repo.text;
}

function showLoaderForSelect2(dropdown) {
    $(".bps-spinner").hide();
    $(dropdown).siblings(".bps-spinner").show();
}