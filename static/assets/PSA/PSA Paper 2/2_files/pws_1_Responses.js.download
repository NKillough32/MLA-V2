
function setResponseData() {
    var monitorUserActivity = $("#MonitorUserActivity").val();
    var isPractice = $("#IsPractice").val();

    var pwsResponseObject = new Object();

    pwsResponseObject.ResponseDate = $("#responseDate").val();

    pwsResponseObject.ResponseTime = $("#responseTime").val();

    if ($("#searchDrugs option").length > 1) {
        pwsResponseObject.Drug = $("#searchDrugs option[value]").last().text().trim();
    }
    else {
        pwsResponseObject.Drug = $("#searchDrugs").text().trim();
    }
    if ($("#searchDoses option").length > 1) {
        pwsResponseObject.Dose = $("#searchDoses option[value]").last().text().trim();
    }
    else {
        pwsResponseObject.Dose = $("#searchDoses").text().trim();
    }
    if ($("#searchRoutes option").length > 1) {
        pwsResponseObject.Route = $("#searchRoutes option[value]").last().text().trim();
        pwsResponseObject.RouteId = $("#searchRoutes option[value]").last().val() ;
    }
    else {
        pwsResponseObject.Route = $("#Route").text().trim();
        pwsResponseObject.RouteId = $("#RouteId").val();
    }

    var currentPwsItemType = $("#ItemType").val();

    if (currentPwsItemType == "PWS-2" || currentPwsItemType == "PWS-4") {

        if ($("#searchFrequency option").length > 1) {
            pwsResponseObject.Frequency = $("#searchFrequency option[value]").last().text().trim();
            pwsResponseObject.FrequencyId = $("#searchFrequency option[value]").last().val();
        }
        else {
            pwsResponseObject.Frequency = $("#searchFrequency").text().trim();
            pwsResponseObject.FrequencyId = $("#searchFrequency").val();
        }
    }

    if (currentPwsItemType == "PWS-3") {

        if ($("#duration option").length > 1) {
            pwsResponseObject.Duration = $("#duration option[value]").last().text().trim();
            pwsResponseObject.DurationId = $("#duration option[value]").last().val();
        }
        else {
            pwsResponseObject.Duration = $("#duration").text().trim();
            pwsResponseObject.DurationId = $("#duration").val();
        }
    }

    var responseDataString = JSON.stringify(pwsResponseObject);

    if (isPractice == "False" && monitorUserActivity == "True") {

        var pwsAnswer = `Drug: ${pwsResponseObject.Drug}, Dose: ${pwsResponseObject.Dose}, Route: ${pwsResponseObject.Route}, RouteId: ${pwsResponseObject.RouteId},Frequency: ${pwsResponseObject.Frequency}, FrequencyId: ${pwsResponseObject.FrequencyId}, Duration: ${pwsResponseObject.Duration}, DurationId: ${pwsResponseObject.DurationId}`

        var pwsAnswerTrimmed = pwsAnswer.replace(/\s/g, ' ');

        CaptureAnswers(pwsAnswerTrimmed);

        $("#UserActivityJSON").val(GetUserActivityJSON());

        ClearActivityJSON();
    }

    $("#Pwsitems_ResponseData").val(responseDataString);
    $("#formAssessmentTest").submit();
}

function setIsSelectedOption(optionId, IsCorrectOption, itemScore) {
    var ischecked = $(".optionCheckbox[data-checkbox-optionId='" + optionId + "']").is(":checked");
    ischecked ? $('#Moqitems_MoqResponsedetail_ResponseOptionId').val(optionId) : $('#Moqitems_MoqResponsedetail_ResponseOptionId').val('');;
    if (IsCorrectOption === 'True') {
        $('#Moqitems_MoqResponsedetail_ResponseOptionScore').val(itemScore);
    }
}

function initializeDrugSelect2(loadDrugsUrl, type) {
    var searchText = '';

    $("#searchDrugs").select2({
        allowClear:true,
        placeholder: function () {
            $(this).data('placeholder');
        },
        ajax: {
            url: loadDrugsUrl,
            dataType: 'json',
            delay: 350,
            beforeSend: function () {
                $("#searchDrugs").siblings(".bps-spinner").show();
            },
            data: function (params) {
                searchText = params.term;
                var jurisdictionId = $('#JurisdictionId').val();
                var languageId = $("#LanguageId").val();
                var pwsOption = $('#ItemType').val();
                var prescribingTypeHF = 0;
                var prescribingTypeOOM = 0;
                var prescribingTypeRM = 0;
                var prescribingTypeGP = 0;
                switch (pwsOption) {
                    case "PWS-1":
                        prescribingTypeOOM = 1;
                        break;
                    case "PWS-2":
                        prescribingTypeRM = 1;
                        break;
                    case "PWS-3":
                        prescribingTypeHF = 1;
                        break;
                    case "PWS-4":
                        prescribingTypeGP = 1;
                        break;
                }
                return {
                    SearchText: params.term, // search term
                    SearchCriteriaForOOM: prescribingTypeOOM,
                    SearchCriteriaForGP: prescribingTypeGP,
                    SearchCriteriaForHF: prescribingTypeHF,
                    SearchCriteriaForRM: prescribingTypeRM,
                    SearchType: type,
                    JurisdictionId: jurisdictionId,
                    LanguageId:languageId
                };
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("#searchDrugs").siblings(".bps-spinner").hide();
            },
            processResults: function (data) {

                $("#searchDrugs").siblings(".bps-spinner").hide();

                CaptureDropdownSearch(type, searchText);

                var drugGroup = data.Results;
                if (drugGroup != null && drugGroup.length > 0) {
                    return {
                        results: $.map(drugGroup, function (item) {
                            return {
                                text: item.Name,
                                id: item.Id
                            };
                        })
                    };
                } else {
                    return {
                        results: []
                    };
                }
            },
            cache: false
        },
        escapeMarkup: function (markup) {
            return markup;
        }, // let our custom formatter work
        minimumInputLength: 3,
        selectOnClose: true,
        templateSelection: formatRepoSelection
    });

    $('#searchDrugs').on('select2:select', function (e) {
        var data = e.params.data;
        var selectedText = `${data.text} -- ${data.id}`;
        CaptureDropdownSelectedText(type, selectedText);
    });
}

